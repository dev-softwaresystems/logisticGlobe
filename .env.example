# Local-only infrastructure; services bind to loopback.
POSTGRES_PORT=5432
MONGODB_PORT=27017
REDIS_PORT=6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=logistics
# Optional local application containers, served on loopback.
APP_WEB_PORT=8080
APP_WEB_ORIGIN=http://localhost:8080
# Public approved tiles and attribution, never private secrets.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

