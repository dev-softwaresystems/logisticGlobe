NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logistics
MONGODB_URI=mongodb://localhost:27017/logistics
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Provide only when intentionally creating the development administrator.
SEED_ADMIN_EMAIL=admin@logisticsglobe.local
SEED_ADMIN_PASSWORD=
# Optional integrations; empty means disabled. Tokens must be distinct, >=32 characters.
GPS_INGEST_TOKEN=
# Comma-separated UUIDs; mandatory when the GPS token is enabled.
GPS_ALLOWED_VEHICLE_IDS=
# Origin only, e.g. https://approved-routing.example. OSRM-compatible provider.
ROUTING_URL=
# Private Prometheus scraper token; keep outside source and browser configuration.
METRICS_TOKEN=
DISTRIBUTED_REALTIME=false
DISTRIBUTED_RATE_LIMIT=false
# Only enable behind a trusted proxy that replaces forwarding headers.
TRUST_PROXY_HOPS=0


# Zona operativa para cortes diarios (IANA)
OPERATION_TIME_ZONE=America/Mexico_City


# Sonda HEAD no facturable, aprobada por el proveedor; vacía = salud desconocida
ROUTING_HEALTH_PATH=

