generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  LOGISTICS_ADMIN
  FLEET_SUPERVISOR
  TRAFFIC_COORDINATOR
  WAREHOUSE_MANAGER
  VIEWER
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ShipmentPriority {
  NORMAL
  HIGH
}

enum VehicleStatus {
  AVAILABLE
  ON_ROUTE
  MAINTENANCE
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  passwordHash String
  active       Boolean          @default(true)
  roles        Role[]
  sessions     RefreshSession[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model Shipment {
  id          String                  @id @default(uuid())
  reference   String                  @unique
  status      ShipmentStatus          @default(PENDING)
  priority    ShipmentPriority        @default(NORMAL)
  origin      String
  destination String
  vehicleId   String?
  vehicle     Vehicle?                @relation(fields: [vehicleId], references: [id])
  history     ShipmentStatusHistory[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status, priority])
}

model ShipmentStatusHistory {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  occurredAt DateTime       @default(now())
  actorId    String?

  @@index([shipmentId, occurredAt])
}

model Vehicle {
  capacityKg Int?
  id         String        @id @default(uuid())
  plate      String        @unique
  status     VehicleStatus @default(AVAILABLE)
  shipments  Shipment[]
  routePlans RoutePlan[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Warehouse {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  capacityUnits Int
  items         InventoryItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model InventoryItem {
  id          String              @id @default(uuid())
  sku         String
  name        String
  quantity    Int                 @default(0)
  warehouseId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  threshold   InventoryThreshold?
  alerts      InventoryAlert[]
  movements   InventoryMovement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([warehouseId, sku])
}

model InventoryThreshold {
  id              String        @id @default(uuid())
  itemId          String        @unique
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  minimumQuantity Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InventoryAlert {
  id         String        @id @default(uuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([resolvedAt, createdAt])
}

model InventoryMovement {
  id               String        @id @default(uuid())
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actorId          String
  previousQuantity Int
  quantity         Int
  reason           String
  createdAt        DateTime      @default(now())

  @@index([itemId, createdAt])
}

model OutboxEvent {
  actorId     String?
  id          String    @id
  body        Json
  deliveredAt DateTime?
  leaseOwner  String?
  leaseUntil  DateTime?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  targetId  String
  action    String
  changes   Json
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model DashboardSnapshot {
  id         String   @id @default(uuid())
  timeZone   String
  cutAt      DateTime
  observedAt DateTime @default(now())
  active     Int

  @@unique([timeZone, cutAt])
}

model RoutePlan {
  id          String           @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  version     Int
  requestId   String           @unique
  requestHash String
  shipmentIds String[]
  geometry    Json
  parameters  Json
  actorId     String
  effectiveAt DateTime         @default(now())
  retiredAt   DateTime?
  createdAt   DateTime         @default(now())
  state       MonitoringState?
  incidents   RouteIncident[]

  @@unique([vehicleId, version])
  @@index([vehicleId, retiredAt])
}

model MonitoringState {
  planId            String    @id
  plan              RoutePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  lastObservationId String?
  lastObservedAt    DateTime?
  state             Json
  updatedAt         DateTime  @updatedAt
}

model RouteIncident {
  id                   String                 @id @default(uuid())
  planId               String
  plan                 RoutePlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind                 String
  openingObservationId String
  startedAt            DateTime
  lastObservedAt       DateTime
  resolvedAt           DateTime?
  acknowledgedAt       DateTime?
  acknowledgedBy       String?
  history              RouteIncidentHistory[]

  @@unique([planId, kind, openingObservationId])
  @@index([resolvedAt, startedAt])
}

model RouteIncidentHistory {
  id            String        @id @default(uuid())
  incidentId    String
  incident      RouteIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action        String
  observationId String?
  actorId       String?
  note          String?
  occurredAt    DateTime      @default(now())
}

model IntegrationReceipt {
  id          String   @id @default(uuid())
  source      String
  externalId  String
  version     Int
  fingerprint String
  status      String
  result      Json
  actorId     String
  observedAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([source, externalId, version])
  @@index([source, externalId, version])
}
